{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GUGU",
  "version": "0.1.0",
  "identifier": "com.yanhaiyang.gugu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "咕咕",
        "url": "index.html?window=widget",
        "width": 322,
        "height": 604,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "minWidth": 260,
        "minHeight": 360,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 16.0
        }
      },
      {
        "label": "panel",
        "title": "咕咕 · 面板",
        "url": "index.html?window=panel",
        "width": 480,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 16.0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
